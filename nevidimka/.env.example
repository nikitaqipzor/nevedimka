# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456789:AAExampleBotTokenPlaceholderXXXXXXXXXXX
# Optional now — each user can connect their own channel via /settings in
# the Mini App or bot (see packages/db's users.channel_id). This is only
# a fallback for users who haven't connected one yet.
TELEGRAM_CHANNEL_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
# Polling works with this empty. For webhook mode set a public HTTPS URL
# and a TELEGRAM_WEBHOOK_SECRET generated with openssl rand -hex 32.
PORT=3000
# Mini App (apps/web) server port — separate from the bot's PORT above,
# since both can run as independent processes on the same machine.
WEB_PORT=3000
BOT_PORT=3001

# --- Logging ---
# error | warn | info | debug | trace. Defaults to "info" if unset.
LOG_LEVEL=info

# --- Database ---
# Restricted NOBYPASSRLS role used for user-owned queries.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres
# Separate privileged role for auth bootstrap, reminders, worker claims,
# recovery, and migrations. Required when NODE_ENV=production. For an
# owner-only local environment it may temporarily match DATABASE_URL.
SYSTEM_DATABASE_URL=
# Generate both Compose passwords independently: openssl rand -hex 32.
# Local Docker Compose role names/passwords. Compose builds its own database
# URLs from these values and ignores the two external URLs above.
POSTGRES_PASSWORD=
APP_DB_USER=nevidimka_app
APP_DB_PASSWORD=

# --- Supabase (if used instead of raw Postgres) ---
SUPABASE_URL=https://your-project-ref.supabase.co

SUPABASE_SERVICE_ROLE_KEY=

# --- AI ---
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
# Model string for the Claude API (Claude Platform). Check
# https://docs.claude.com for the current list before deploying —
# this is a reasonable default as of writing.
AI_MODEL=claude-sonnet-5
# Per-user rate limit on AI calls (any role), enforced in callRole before
# each request — see packages/ai/src/rateLimit.ts. Defaults are generous
# for genuine single-user daily use; tighten if running multi-user.
AI_RATE_LIMIT_WINDOW_MINUTES=60
AI_RATE_LIMIT_MAX_CALLS=40

# --- Mini App (apps/web) ---
# Random secret for signing the Mini App's session cookie (openssl rand -hex 32).
JWT_SECRET=
APP_BASE_URL=https://your-domain.example.com
# Owner's Telegram numeric user id. Used by apps/bot's Release-1 scenario,
# and by apps/web outside production as a dev-only auth fallback so the
# Mini App is testable in a plain browser without a Telegram host.
OWNER_TELEGRAM_ID=
# Explicit opt-in for the dev-only auth bypass in apps/web — leave
# unset/false in every real deployment, even staging; only set to "true" on
# your own machine when testing the Mini App outside Telegram.
ALLOW_DEV_AUTH=

# --- Video pipeline (Release 4: apps/worker) ---
# Local evidence files uploaded through daily reports. Every process that
# can delete an account must mount/read this same directory.
EVIDENCE_STORAGE_ROOT=./apps/bot/storage/evidence
# Shared local directory for video pipeline outputs (work files, preview,
# cover, final render, and original Telegram uploads. apps/bot and
# apps/worker WRITE here; apps/web READS and deletes here — all three must
# point at the same path (or shared volume) in a multi-process deployment.
VIDEO_STORAGE_ROOT=./storage/video
# How often (ms) apps/worker polls for pending video jobs.
WORKER_POLL_INTERVAL_MS=5000
# If a job sits in 'processing'/'rendering' longer than this (minutes), the
# worker assumes it crashed mid-job and requeues it automatically.
WORKER_STALE_JOB_MINUTES=15
# Test-only override: points the Telegram client at a mock server instead
# of the real Bot API. Leave unset in every real deployment.
TELEGRAM_API_BASE_URL=
# Same idea, for the Anthropic client. Leave unset in every real deployment.
ANTHROPIC_API_BASE_URL=

# --- Speech transcription (ASR) ---
# An OpenAI API key. Enables: subtitles on published videos, and
# automatic transcription of voice/video daily reports (instead of asking
# you to type a summary). Leave unset to skip this entirely — everything
# else works the same either way, just without a transcript.
# HONEST NOTE: this integration (packages/video/src/asr.ts) was built and
# tested against a mock server matching OpenAI's documented API shape, but
# was never exercised against the real api.openai.com — the environment
# it was built in couldn't reach that domain. Treat your first real
# transcription as the actual first test of this specific integration.
ASR_API_KEY=
# Test-only override, same idea as the other _API_BASE_URL vars above.
ASR_API_BASE_URL=
