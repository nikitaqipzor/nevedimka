    "migrate:down": "tsx src/migrate.ts down",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@nevidimka/shared-types": "*",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
